#!/usr/bin/env sh
# Cross-platform entry-point script for running the frontend.
# Auto-detects OS and dispatches to the correct script.

SCRIPT_DIR=$(dirname "$0")
BASENAME=$(basename "$0" .sh)

case "$(uname -s)" in
    CYGWIN*|MINGW*|MSYS*|MINGW32*|MINGW64*)
        exec "$SCRIPT_DIR/run-frontend.bat"
        ;;
    *)
        exec "$SCRIPT_DIR/run-frontend.sh"
        ;;
esac
