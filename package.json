{
  "name": "burninguard-ai",
  "version": "2.0.0",
  "private": true,
  "description": "BurnInGuard AI 2.0 - Physics-informed, explainable PASS/FAIL prediction for component burn-in screening",
  "workspaces": [
    "backend",
    "frontend",
    "model-training"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "./scripts/run-backend",
    "dev:frontend": "./scripts/run-frontend",
    "install": "./scripts/install-dependencies",
    "serve": "./scripts/run-frontend",
    "build": "cd frontend && npm run build",
    "train": "./scripts/train-models",
    "predict": "cd backend && python predict.py",
    "prediction:csv": "cd backend && python predict.py --input prediction_input.csv --output outputs/prediction_output.csv",
    "test": "make test",
    "clean": "make clean"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
