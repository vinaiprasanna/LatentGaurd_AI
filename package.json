{
  "name": "latentguard-ai",
  "version": "1.0.0",
  "private": true,
  "description": "LatentGuard AI - Physics-informed, explainable PASS/FAIL prediction for component burn-in screening",
  "workspaces": [
    "backend",
    "frontend",
    "model-training"
  ],
  "scripts": {
    "install:all": "node scripts/install-all.js",
    "train": "node scripts/train-all.js",
    "dev:backend": "node scripts/run-backend.js",
    "dev:frontend": "node scripts/run-frontend.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "test": "node scripts/test-all.js",
    "clean": "node scripts/clean-all.js",
    "setup": "npm run install:all && npm run train"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
